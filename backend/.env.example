# Demo mode (default) — no Splunk instance required
USE_MOCK_SPLUNK=true
USE_SPLUNK_MCP=true

# Live Splunk — set USE_MOCK_SPLUNK=false and fill in host + credentials
# SPLUNK_HOST=your-splunk-host.example.com
# SPLUNK_PORT=8089
# SPLUNK_HEC_PORT=8088
# SPLUNK_INDEX=main
# SPLUNK_WEB_URL=https://your-splunk-host.example.com:8000

# Auth option A: HEC token (for seed script + ingest) + session token for search
# SPLUNK_TOKEN=your-token-here

# Auth option B: Splunk admin/user login (REST search on port 8089)
# SPLUNK_USERNAME=admin
# SPLUNK_PASSWORD=changeme
